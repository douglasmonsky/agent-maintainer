#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
repo_root="$(cd "$repo_root" && pwd -P)"
launch_label="com.openai.symphony.agent-maintainer"

if ! job="$(launchctl print "gui/$UID/$launch_label" 2>/dev/null)"; then
  printf 'Symphony is not running (no launch job).\n'
  exit 0
fi

if [[ "$job" != *"SYMPHONY_REPO_ROOT=$repo_root"* ]] ||
  [[ "$job" != *"$repo_root/scripts/run-symphony"* ]]; then
  printf 'Refusing to stop an unrecognized launch job: %s\n' "$launch_label" >&2
  exit 1
fi

launchctl remove "$launch_label"
for _ in {1..20}; do
  if ! launchctl print "gui/$UID/$launch_label" >/dev/null 2>&1; then
    printf 'Symphony stopped.\n'
    exit 0
  fi
  sleep 0.5
done

printf 'Symphony launch job did not stop: %s\n' "$launch_label" >&2
exit 1
