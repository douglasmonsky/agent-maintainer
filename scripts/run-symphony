#!/usr/bin/env bash
set -euo pipefail

repo_root="${SYMPHONY_REPO_ROOT:?SYMPHONY_REPO_ROOT is required}"
state_root="${SYMPHONY_STATE_ROOT:-$HOME/.codex/symphony/agent-maintainer}"
symphony_bin="${SYMPHONY_BIN:-$HOME/.codex/bin/symphony}"
port="${SYMPHONY_PORT:-4000}"

export GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token)}"

exec "$symphony_bin" \
  --i-understand-that-this-will-be-running-without-the-usual-guardrails \
  --logs-root "$state_root/logs" \
  --port "$port" \
  "$repo_root/WORKFLOW.md"
